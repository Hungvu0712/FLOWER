# Database (Neon Postgres for dev — see ARCHITECTURE.md §7)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# App
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookie
COOKIE_SECRET=change-me-cookie-secret

# Google OAuth (ID token verification — see modules/core/auth)
GOOGLE_CLIENT_ID=

# Cloudflare R2 (S3-compatible) — see ARCHITECTURE.md §8
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://your-bucket-domain.example.com

# Email — see ARCHITECTURE.md §9 (EMAIL_PROVIDER: 'resend' | 'smtp')
EMAIL_PROVIDER=smtp
EMAIL_FROM="Flower Shop <no-reply@example.com>"
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Magic link
MAGIC_LINK_TTL_MINUTES=15
MAGIC_LINK_BASE_URL=http://localhost:3000/magic-link/verify

# Password reset
PASSWORD_RESET_TTL_MINUTES=30
