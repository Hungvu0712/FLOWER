generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================
// CORE (reusable) — giữ nguyên khi copy source base sang dự án PERN khác
// Xem docs/02 §2 và docs/05 §3.1-3.3
// =====================================================================

model User {
  id                  String    @id @default(uuid())
  fullName            String    @map("full_name")
  email               String    @unique
  passwordHash        String?   @map("password_hash") // null nếu user chỉ dùng Google/magic link
  phone               String?
  avatarFileId        String?   @map("avatar_file_id")
  avatarFile          File?     @relation(fields: [avatarFileId], references: [id])
  status              String    @default("active") // 'active' | 'blocked'
  emailVerifiedAt     DateTime? @map("email_verified_at")
  // docs/12 BE-17: khoá TẠM sau nhiều lần đăng nhập sai liên tiếp — khác `status: 'blocked'` (admin
  // chủ động khoá, vĩnh viễn tới khi admin mở lại). Reset về 0/null ngay khi đăng nhập đúng mật khẩu.
  failedLoginAttempts Int       @default(0) @map("failed_login_attempts")
  lockedUntil         DateTime? @map("locked_until")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  roles         UserRole[]
  authAccounts  AuthAccount[]
  sessions      Session[]
  auditLogs     AuditLog[]    @relation("AuditActor")
  uploadedFiles File[]        @relation("UploadedBy")
  folders       Folder[]      @relation("FolderCreatedBy")
  orders        Order[]
  addresses     Address[]
  wishlists     Wishlist[]
  reviews       Review[]
  couponUsages  CouponUsage[]
  blogPosts     BlogPost[]
  specialDates  SpecialDate[]

  @@map("users")
}

model Role {
  id          Int      @id @default(autoincrement())
  code        String   @unique
  name        String
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  permissions RolePermission[]
  users       UserRole[]

  @@map("roles")
}

model Permission {
  id           Int      @id @default(autoincrement())
  code         String   @unique
  groupName    String   @map("group_name")
  isSystem     Boolean  @default(false) @map("is_system")
  isRestricted Boolean  @default(false) @map("is_restricted")
  description  String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId String
  roleId Int
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model AuthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String // 'google'
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("auth_accounts")
}

model Session {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  deviceName       String?   @map("device_name")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  lastActiveAt     DateTime  @default(now()) @map("last_active_at")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  // Chỉ set khi bị thu hồi DO XOAY VÒNG ở /auth/refresh — phân biệt với thu hồi hợp lệ khác (đăng xuất
  // thiết bị, đổi mật khẩu, superadmin khoá/reset) vốn chỉ set revokedAt. Reuse detection chỉ dựa vào
  // cột này, xem auth.service.ts#refreshSession và docs/12 BE-25.
  rotatedAt        DateTime? @map("rotated_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  userId    String?   @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("magic_link_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("password_reset_tokens")
}

model LoginMethodSetting {
  id        Int      @id @default(autoincrement())
  method    String   @unique // 'google_oauth' | 'email_password' | 'magic_link'
  isEnabled Boolean  @default(true) @map("is_enabled")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("login_method_settings")
}

// Bảng key-value tổng quát (docs/12, Phase 4) — `value` luôn là JSON-encode (kể cả string/boolean
// đơn giản), vì mỗi key có kiểu dữ liệu khác nhau (site_name: string, maintenance_mode: boolean...)
// và cột string chung không tự phân biệt được. Danh sách key hợp lệ + kiểu tương ứng của TỪNG key:
// modules/core/settings/systemSettings.validation.ts (không phải chấp nhận key bất kỳ — validate()
// tĩnh ở tầng route không biết trước :key nên phải re-validate theo key ở service, xem file đó).
// Khác `login_method_settings` — KHÔNG gộp 2 bảng làm 1 trong lần này, xem docs/modules/core-settings.md §4.
model SystemSetting {
  key       String   @id
  value     String
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model Folder {
  id        String   @id @default(uuid())
  name      String
  parentId  String?  @map("parent_id")
  createdBy String?  @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  parent  Folder?  @relation("FolderTree", fields: [parentId], references: [id])
  folders Folder[] @relation("FolderTree")
  files   File[]
  creator User?    @relation("FolderCreatedBy", fields: [createdBy], references: [id])

  @@map("folders")
}

model File {
  id                 String    @id @default(uuid())
  folderId           String?   @map("folder_id")
  cloudinaryPublicId String    @unique @map("cloudinary_public_id")
  url                String
  mimeType           String    @map("mime_type")
  sizeBytes          Int       @map("size_bytes")
  originalName       String    @map("original_name")
  uploadedBy         String?   @map("uploaded_by")
  createdAt          DateTime  @default(now()) @map("created_at")
  deletedAt          DateTime? @map("deleted_at")

  folder               Folder?        @relation(fields: [folderId], references: [id])
  uploader             User?          @relation("UploadedBy", fields: [uploadedBy], references: [id])
  usages               FileUsage[]
  avatarOf             User[]
  imageOfCategories    Category[]
  productImages        ProductImage[]
  thumbnailOfBlogPosts BlogPost[]

  @@index([deletedAt])
  @@map("files")
}

model FileUsage {
  id         String   @id @default(uuid())
  fileId     String   @map("file_id")
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  createdAt  DateTime @default(now()) @map("created_at")

  file File @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@unique([fileId, entityType, entityId])
  @@index([entityType, entityId])
  @@map("file_usages")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation("AuditActor", fields: [actorId], references: [id])

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EmailLog {
  id                String   @id @default(uuid())
  toEmail           String   @map("to_email")
  type              String // 'welcome' | 'magic_link' | 'password_reset' | 'order_confirmation'...
  status            String // 'sent' | 'failed'
  providerMessageId String?  @map("provider_message_id")
  error             String?
  sentAt            DateTime @default(now()) @map("sent_at")

  @@map("email_logs")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  phone     String
  email     String?
  message   String
  isHandled Boolean  @default(false) @map("is_handled")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([isHandled])
  @@map("contact_messages")
}

// =====================================================================
// DOMAIN (flower shop specific) — thay thế bằng nghiệp vụ của dự án mới
// Xem docs/05 §3.4-3.6. Đây chỉ là placeholder tối thiểu để tránh
// migration rỗng — mở rộng dần theo README.md khi triển khai tính năng.
// =====================================================================

model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  imageFileId String?  @map("image_file_id")
  parentId    String?  @map("parent_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  imageFile File?      @relation(fields: [imageFileId], references: [id])
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]

  @@map("categories")
}

model Product {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?
  // VND không có đơn vị lẻ (không như USD có cent) — dùng Int lưu nguyên giá trị VND, tránh phải
  // đụng tới kiểu Decimal của Prisma (phức tạp hơn khi serialize JSON) khi chưa có nhu cầu đa tiền tệ.
  basePrice   Int       @default(0) @map("base_price")
  // KHÔNG có tồn kho (stock) — hoa tươi làm theo đơn/theo mẫu tại thời điểm đặt, không phải hàng lưu
  // kho theo SKU cố định. Nếu sau này bán thêm phụ kiện/lọ hoa có tồn kho thật, thêm lại ở bảng riêng,
  // đừng thêm lại cột này cho products.
  categoryId  String?   @map("category_id")
  isActive    Boolean   @default(true) @map("is_active")
  // Khác categories (hard delete) — products cần soft delete vì sẽ được order_items tham chiếu sau
  // này (đơn hàng cũ vẫn phải hiển thị đúng tên/giá sản phẩm dù sản phẩm đã ngừng bán). Xem docs/05 §3.4.
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  category   Category?         @relation(fields: [categoryId], references: [id])
  images     ProductImage[]
  variants   ProductVariant[]
  occasions  ProductOccasion[]
  orderItems OrderItem[]
  wishlists  Wishlist[]
  reviews    Review[]

  @@index([deletedAt])
  @@index([categoryId])
  @@map("products")
}

// Tag dịp lễ (Sinh nhật, Valentine, Khai trương...) — KHÁC categories: phẳng (không cây cha-con), 1
// sản phẩm gắn được NHIỀU dịp lễ cùng lúc (n-n qua product_occasions), trong khi categoryId trên
// Product chỉ 1-n. Xem docs/05 §3.4.
model Occasion {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  sortOrder Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  products ProductOccasion[]

  @@map("occasions")
}

// Bảng nối n-n thuần (không có cột riêng) — theo đúng khuôn mẫu role_permissions/user_roles đã dùng
// trong schema này (composite PK, KHÔNG dùng implicit many-to-many của Prisma). onDelete: Cascade cả
// 2 chiều — xoá sản phẩm hoặc xoá occasion chỉ gỡ tag liên quan, không cần ràng buộc xoá riêng như
// categories (danh mục con) hay product_variants (order_items tham chiếu).
model ProductOccasion {
  productId  String @map("product_id")
  occasionId String @map("occasion_id")

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  occasion Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)

  @@id([productId, occasionId])
  @@index([occasionId])
  @@map("product_occasions")
}

// Mức giá theo kích cỡ (Nhỏ/Vừa/Lớn...) — KHÔNG có tồn kho riêng, cùng lý do với `products.basePrice`
// (hoa tươi làm theo đơn). 1 sản phẩm có thể có 0 biến thể (dùng thẳng `basePrice`) hoặc nhiều biến
// thể (khi đó `basePrice` chỉ còn ý nghĩa "giá từ..." hiển thị ở trang danh sách — trang chi tiết bắt
// khách chọn 1 biến thể cụ thể mới ra giá thật, xem products.service.ts). Xem docs/05 §3.4.
model ProductVariant {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  name      String
  price     Int
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  fileId    String   @map("file_id")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    File    @relation(fields: [fileId], references: [id])

  @@unique([productId, fileId])
  @@index([productId])
  @@map("product_images")
}

// Giai đoạn "cơ bản" (xem docs/modules/domain-orders.md) — CHƯA có: order_deliveries riêng (nhúng
// thẳng field giao hàng vào orders, chưa cần shipperId vì chưa có màn phân công), payments/
// payment_status (chỉ COD, xác nhận qua điện thoại), shipping_fee (chưa có phí ship),
// order_status_history riêng (dùng lại AuditLog chung, action "order.update_status"). CÓ
// couponCode/discountAmount (mã giảm giá — xem model Coupon bên dưới, docs/modules/domain-coupons.md).
// Đây là các bảng ⬜ còn lại trong docs/05 §3.4/§3.7 — xây tiếp khi làm thanh toán online / phân công
// shipper thật.
model Order {
  id        String  @id @default(uuid())
  // Mã đơn NGẮN, DỄ ĐỌC để khách đọc qua điện thoại — KHÁC `id` (UUID): id dùng làm token tra cứu
  // công khai (GET /orders/:id không cần đăng nhập), orderCode chỉ để hiển thị/tìm kiếm nội bộ, không
  // đủ khó đoán để dùng làm quyền truy cập (tránh IDOR — xem docs/07 §2).
  orderCode String  @unique @map("order_code")
  userId    String? @map("user_id") // null = khách đặt không đăng nhập (guest checkout)

  status        String @default("pending") @map("status") // 'pending'|'confirmed'|'preparing'|'delivering'|'completed'|'cancelled' — xem ORDER_STATUSES
  paymentMethod String @default("cod") @map("payment_method") // chỉ 'cod' ở giai đoạn này

  subtotal       Int // tổng tiền hàng (= tổng subtotal của order_items), TRƯỚC khi trừ giảm giá
  // Snapshot mã đã dùng (không JOIN sống tới coupons — coupon có thể bị sửa/xoá sau, đơn cũ vẫn phải
  // hiển thị đúng mã đã áp dụng lúc đặt). null = không dùng mã.
  couponCode     String? @map("coupon_code")
  discountAmount Int     @default(0) @map("discount_amount") // số tiền ĐÃ giảm thật (0 nếu không có mã)
  total          Int // = subtotal - discountAmount (chưa có shipping_fee)

  recipientName    String   @map("recipient_name") // người NHẬN hoa — có thể khác người đặt
  recipientPhone   String   @map("recipient_phone")
  deliveryAddress  String   @map("delivery_address")
  deliveryDate     DateTime @map("delivery_date") @db.Date // ĐẶC THÙ ngành hoa — giao đúng ngày hẹn
  deliveryTimeSlot String   @map("delivery_time_slot") // 'sang'|'chieu'|'toi'
  note             String?

  // Xác minh đơn qua cuộc gọi điện thoại (docs/07 nợ bảo mật "SĐT giả") — chỉ giữ trạng thái MỚI
  // NHẤT để hiển thị nhanh; lịch sử đầy đủ nhiều lần gọi nằm ở AuditLog (action "order.call_logged"),
  // KHÔNG có bảng riêng — xem docs/modules/domain-orders.md §2. callConfirmedAt null = chưa xác nhận
  // qua điện thoại lần nào → chặn chuyển status sang 'confirmed' (orders.service.ts#updateStatus).
  callConfirmedAt DateTime? @map("call_confirmed_at")
  lastCallAt      DateTime? @map("last_call_at")
  lastCallNote    String?   @map("last_call_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user        User?        @relation(fields: [userId], references: [id])
  items       OrderItem[]
  couponUsage CouponUsage?

  @@index([userId])
  @@index([status])
  @@index([deliveryDate])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(uuid())
  orderId String @map("order_id")

  // Sao chép (snapshot) tên/giá TẠI THỜI ĐIỂM ĐẶT — sản phẩm sau này có thể đổi tên/giá/bị xoá mềm,
  // đơn hàng cũ vẫn phải hiển thị đúng những gì khách đã đặt lúc đó (khác kiểu JOIN sống tới products).
  productId   String? @map("product_id")
  productName String  @map("product_name")
  // Biến thể (size) ĐÃ CHỌN lúc đặt, nếu sản phẩm có biến thể — cũng snapshot tên riêng, KHÔNG dựa
  // vào JOIN sống tới product_variants (cùng lý do với productName ở trên: biến thể có thể bị admin
  // xoá/đổi tên/đổi giá sau này, đơn cũ vẫn phải hiển thị đúng những gì khách đã chọn lúc đặt).
  variantId   String? @map("variant_id")
  variantName String? @map("variant_name")
  unitPrice   Int     @map("unit_price")
  quantity    Int
  subtotal    Int // unitPrice * quantity, lưu sẵn tránh tính lại

  order   Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@map("order_items")
}

// Sổ địa chỉ người nhận — khách lưu nhiều địa chỉ giao hoa, chọn nhanh lúc đặt hàng (autofill form
// checkout) thay vì gõ lại mỗi lần. Thuần dữ liệu cá nhân — KHÔNG có permission riêng, chỉ cần
// authenticate (giống /account/profile), xem docs/modules/domain-addresses.md.
model Address {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  recipientName  String   @map("recipient_name")
  recipientPhone String   @map("recipient_phone")
  addressLine    String   @map("address_line")
  ward           String?
  district       String?
  city           String?
  // Tối đa 1 địa chỉ mặc định/user — enforce ở service (unset địa chỉ mặc định cũ trước khi đặt cái
  // mới), KHÔNG dùng unique index (Postgres unique cho phép NHIỀU giá trị false/null, không chặn
  // được nhiều hàng cùng true trong 1 cột boolean thường).
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// Danh sách yêu thích — bảng nối n-n thuần (composite PK, giống product_occasions/role_permissions),
// KHÔNG dùng implicit many-to-many của Prisma. Xem docs/modules/domain-wishlist.md.
model Wishlist {
  userId    String   @map("user_id")
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
  @@map("wishlists")
}

// Đánh giá sản phẩm — CẦN duyệt trước khi hiện công khai (isApproved mặc định false), quyền duyệt
// `reviews.moderate` (seed sẵn, xem domain.seed.ts). Mỗi user chỉ đánh giá 1 lần/sản phẩm (unique).
// CHƯA có `images` (đơn giản hoá MVP so với bản thiết kế đầu ở docs/05 §3.4) — xem
// docs/modules/domain-reviews.md §7 việc còn lại.
model Review {
  id         String   @id @default(uuid())
  productId  String   @map("product_id")
  userId     String   @map("user_id")
  rating     Int // 1-5
  comment    String?
  isApproved Boolean  @default(false) @map("is_approved")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([isApproved])
  @@map("reviews")
}

// Mã giảm giá — 1 đơn áp dụng ĐƯỢC TỐI ĐA 1 mã (đơn giản hoá, không cộng dồn nhiều mã cùng lúc).
// `usedCount` đếm sẵn (denormalized) để kiểm tra `usageLimit` nhanh mà không cần COUNT(*) trên
// coupon_usages mỗi lần validate — tăng NGUYÊN TỬ trong cùng transaction lúc tạo đơn
// (orders.service.ts) để chống race condition (2 khách cùng dùng mã còn đúng 1 lượt cuối cùng tại
// cùng thời điểm). Xem docs/modules/domain-coupons.md.
model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  type          String // 'percent' | 'fixed'
  value         Int // percent: 1-100 (%) · fixed: VND nguyên
  minOrderValue Int?      @map("min_order_value") // null = không giới hạn đơn tối thiểu
  startDate     DateTime? @map("start_date") // null = có hiệu lực ngay
  endDate       DateTime? @map("end_date") // null = không hết hạn
  usageLimit    Int?      @map("usage_limit") // null = không giới hạn lượt dùng
  usedCount     Int       @default(0) @map("used_count")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  usages CouponUsage[]

  @@map("coupons")
}

// 1 dòng/đơn ĐÃ dùng mã — unique theo order_id (khớp đúng "1 đơn tối đa 1 mã" ở Coupon). Đây là bản
// ghi LỊCH SỬ (discountAmount snapshot), KHÔNG phải nơi tính lại số dư lượt dùng — usageLimit kiểm
// tra qua Coupon.usedCount.
model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  orderId        String   @unique @map("order_id")
  userId         String?  @map("user_id") // null nếu guest checkout
  discountAmount Int      @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  coupon Coupon @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

// Bài viết blog — permission DÙNG LẠI `blog.manage` (đã seed sẵn từ đầu dự án, chỉ admin/super_admin
// — xem docs/05 §2.4). Soft delete giống Product (khác Category hard delete) — dù chưa có bảng nào
// tham chiếu blog_posts, giữ soft delete để nhất quán + khôi phục được nếu xoá nhầm bài viết dài.
// `publishedAt` null = draft (chỉ admin thấy qua /admin/blog); có giá trị = đã/sẽ xuất bản — public
// chỉ thấy khi `publishedAt <= now()` (cho phép LÊN LỊCH xuất bản tương lai, không cần cột riêng).
model BlogPost {
  id              String    @id @default(uuid())
  authorId        String?   @map("author_id") // nullable — SetNull nếu tài khoản tác giả bị xoá, bài viết vẫn còn
  title           String
  slug            String    @unique
  excerpt         String? // tóm tắt hiện ở trang danh sách — viết tay, KHÔNG tự cắt từ content
  content         String // rich text HTML đã sanitize (sanitizeDescriptionHtml) — giống Product.description
  thumbnailFileId String?   @map("thumbnail_file_id")
  publishedAt     DateTime? @map("published_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  author        User? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  thumbnailFile File? @relation(fields: [thumbnailFileId], references: [id])

  @@index([deletedAt])
  @@index([publishedAt])
  @@map("blog_posts")
}

// Đăng ký nhận email khuyến mãi/tin mới — form ở footer storefront, KHÔNG cần đăng nhập. Permission
// DÙNG LẠI `blog.manage` cho màn xem danh sách quản trị (cùng nhóm "Nội dung" — xem docs/05 §2.4).
// GIỮ LẠI bản ghi khi unsubscribe (isActive: false) thay vì xoá — biết ai đã từng đăng ký/rời đi, và
// để resubscribe không tạo trùng dòng. Đây là giai đoạn "thu thập email" — CHƯA có gửi newsletter
// hàng loạt (soạn + gửi campaign), xem docs/modules/domain-blog.md §7.
model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  isActive       Boolean   @default(true) @map("is_active")
  subscribedAt   DateTime  @default(now()) @map("subscribed_at")
  unsubscribedAt DateTime? @map("unsubscribed_at")

  @@map("newsletter_subscribers")
}

// Nhắc lịch sinh nhật/kỷ niệm — thuần dữ liệu cá nhân, KHÔNG permission riêng (chỉ cần đăng nhập,
// giống Address/Wishlist — xem docs/05 §2.4). `date` chỉ THÁNG-NGÀY có ý nghĩa (lặp lại HẰNG NĂM) —
// năm lưu trong cột không mang ý nghĩa gì, job đọc/ghi luôn cố định UTC để tránh lệch ngày do múi giờ
// (cùng bug đã gặp với Order.deliveryDate, xem orders.service.ts). `lastRemindedYear` chống gửi email
// nhắc trùng nhiều lần cho CÙNG 1 lượt dịp (vd job chạy bù sau khi server restart trong ngày đã gửi) —
// xem docs/modules/domain-special-dates.md.
model SpecialDate {
  id               String   @id @default(uuid())
  userId           String   @map("user_id")
  label            String // "Sinh nhật mẹ", "Kỷ niệm cưới"...
  date             DateTime @db.Date
  remindDaysBefore Int      @default(3) @map("remind_days_before")
  lastRemindedYear Int?     @map("last_reminded_year")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("special_dates")
}
