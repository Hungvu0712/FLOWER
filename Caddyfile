# DNS 2 domain dưới đây phải trỏ (bản ghi A) về đúng IP VPS TRƯỚC KHI khởi động Caddy — Caddy cần
# domain đã trỏ đúng để xin chứng chỉ TLS tự động từ Let's Encrypt (HTTP-01 challenge), không xin được
# thì site vẫn chạy HTTP thường, chưa có HTTPS.
thuymaiflower.click {
    encode gzip zstd
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy frontend:3000
}

# Socket.io (đơn hàng realtime) chạy CHUNG cổng HTTP với REST API (backend:4000) — Caddy tự động nhận
# diện header Connection: Upgrade và proxy WebSocket đúng, không cần cấu hình gì thêm ở đây.
api.thuymaiflower.click {
    encode gzip zstd
    header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    reverse_proxy backend:4000
}
