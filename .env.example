# Biến COMPOSE-LEVEL — chỉ dùng để `docker-compose.yml` (gốc repo) nội suy giá trị `${...}` lúc
# `docker compose build`/`up`. KHÁC `backend/.env.example` (biến runtime bên TRONG container
# backend/worker) — 2 file .env riêng biệt, cả 2 đều cần có trước khi chạy `docker compose up`.
#
# Copy file này thành `.env` (cùng thư mục với docker-compose.yml) rồi điền giá trị thật:
#   cp .env.example .env

# [BẮT BUỘC] Tài khoản Postgres — container `postgres` tự tạo user/database này lúc khởi động LẦN ĐẦU
# (không có tác dụng nếu volume pgdata đã có dữ liệu từ trước). PHẢI khớp với DATABASE_URL trong
# backend/.env (cùng user/password/db, host là "postgres" — tên service trong docker-compose.yml,
# không phải "localhost").
POSTGRES_USER=hoaxinh
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=flower

# [BẮT BUỘC] Được NHÚNG vào bundle frontend lúc `docker compose build` (Next.js đọc NEXT_PUBLIC_* lúc
# build, không đọc lại được lúc container chạy — đổi giá trị này bắt buộc build lại image frontend).
# Trỏ đúng domain API thật, có https:// — ví dụ https://api.hoaxinh.vn (khớp Caddyfile).
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# [tính năng] Chỉ cần nếu bật đăng nhập Google — để trống nếu chưa dùng. Phải khớp GOOGLE_CLIENT_ID
# trong backend/.env.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
